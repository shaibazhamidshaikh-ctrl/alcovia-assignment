          }
        ]
      ]
    },
    "Program or trial?": {
      "main": [
        [
          {
            "node": "Move ClickUp lead → Won",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create onboarding task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "08_error_handler"
  },
